<?xml version="1.0" encoding="utf-8"?>
<!-- Network Security Configuration for ZenFlashCards
     Blocks all cleartext (HTTP) traffic. Only HTTPS allowed.
     Uses system-trusted CAs for certificate validation. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
